opam-version: "2.0"
version: "0.3.3"
synopsis: "Caqti Lwt execution backend for typed-sql"
description:
  "An Lwt adapter that runs typed-sql statements through Caqti PostgreSQL and SQLite connections."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["database" "sql" "caqti" "lwt" "postgresql" "sqlite"]
homepage: "https://github.com/prekel/typed-sql"
bug-reports: "https://github.com/prekel/typed-sql/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml" {>= "5.1.1"}
  "typed-sql" {= version}
  "base"
  "ptime"
  "ppx_let"
  "caqti" {>= "3.0.0" & < "3.1.0~"}
  "caqti-lwt" {>= "3.0.0" & < "3.1.0~"}
  "lwt"
  "base-unix"
  "caqti-driver-sqlite3" {with-test}
  "caqti-driver-postgresql" {with-test}
  "uri" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-sql.git"
x-maintenance-intent: ["(latest)"]
