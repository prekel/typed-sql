(rule
 (target schema_ppx.ml)
 (deps schema.json)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../../bin/typed_sql_codegen.exe}
    --target
    pgocaml-ppx
    %{dep:schema.json}))))

