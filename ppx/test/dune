(rule
 (target offline_queries_ppx.ml)
 (deps offline_queries.json)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../bin/typed_sql_pgocaml_queries.exe}
    codegen
    %{dep:offline_queries.json}))))

(library
 (name typed_sql_pgocaml_test_cache_ppx)
 (optional)
 (modules offline_queries_ppx)
 (kind ppx_rewriter)
 (libraries base typed-sql-pgocaml-ppx))

