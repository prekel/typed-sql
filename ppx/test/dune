(rule
 (alias runtest)
 (package typed-sql-pgocaml-ppx)
 (deps
  compile_fail_test.sh
  (glob_files compile_fail/*.ml))
 (action
  (run
   bash
   %{dep:compile_fail_test.sh}
   %{exe:ppx_driver.exe}
   %{bin:ocamlfind}
   %{lib:typed-sql-pgocaml-ppx.runtime:typed_sql_pgocaml_runtime.cmi})))

