opam-version: "2.0"
version: "0.5.0"
synopsis: "Offline PG'OCaml quotations with schema or query metadata"
description:
  "An experimental PG'OCaml-compatible PPX using embedded schema snapshots or prepared query metadata instead of compile-time database access, with an explicit online preparation tool."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "LGPL-2.0-or-later"
tags: ["database" "sql" "pgocaml" "ppx" "postgresql"]
homepage: "https://github.com/prekel/typed-sql"
bug-reports: "https://github.com/prekel/typed-sql/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "typed-sql-schema" {= version}
  "base"
  "yojson"
  "ppxlib" {>= "0.30.0"}
  "ppx_let"
  "pgocaml" {>= "4.3.0"}
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-sql.git"
