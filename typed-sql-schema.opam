opam-version: "2.0"
version: "0.4.0"
synopsis: "Schema metadata, snapshots and code generation for typed-sql"
description:
  "Build-time schema metadata and OCaml descriptor generation for typed-sql."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["database" "sql" "schema" "codegen"]
homepage: "https://github.com/prekel/typed-sql"
bug-reports: "https://github.com/prekel/typed-sql/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "typed-sql" {= version}
  "base"
  "yojson"
  "ppx_let"
  "ppx_expect" {with-test}
  "ipaddr" {with-test}
  "zarith" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
