# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.4.4"
synopsis: "Typed relational query DSL for OCaml"
description:
  "A backend-independent OCaml DSL for typed relational statements with static and dynamic compilation."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["database" "sql" "query" "dsl" "postgresql" "sqlite"]
homepage: "https://github.com/prekel/typed-sql"
bug-reports: "https://github.com/prekel/typed-sql/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "base"
  "zarith"
  "ptime"
  "yojson"
  "ppx_let"
  "ppx_sexp_conv"
  "ppx_fields_conv" {with-test}
  "qcheck" {with-test}
  "ipaddr" {with-test}
  "mdx" {with-test}
  "ppx_expect" {with-test}
  "bisect_ppx" {with-dev-setup}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-sql.git"
