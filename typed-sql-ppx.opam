# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.5.3"
synopsis: "Offline cached SQL quotations for typed-sql"
description:
  "Driver-independent SQL quotations generating typed raw queries and commands from prepared query metadata."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "LGPL-2.0-or-later"
homepage: "https://github.com/prekel/typed-sql"
bug-reports: "https://github.com/prekel/typed-sql/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "typed-sql" {= version}
  "typed-sql-schema" {= version}
  "base"
  "yojson"
  "ppxlib" {>= "0.30.0"}
  "ppx_let"
  "ppx_expect" {with-test}
  "mdx" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-sql.git"
